{
  "name": "@geekflare/ai-sdk",
  "version": "0.1.0",
  "description": "Geekflare tools for the Vercel AI SDK: web search with Google SERP, page scraping, screenshots, and website diagnostics.",
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel",
    "tools",
    "geekflare",
    "web-search",
    "serp",
    "scraping",
    "screenshot",
    "agents"
  ],
  "homepage": "https://docs.geekflare.com/integrations/ai-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geekflare/geekflare-ai-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/geekflare/geekflare-ai-sdk/issues"
  },
  "license": "MIT",
  "author": "Geekflare <support@geekflare.com>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "ai": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ai": "^7.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
